{
  "name": "united-water-damage-restoration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev --port 5173",
    "build": "astro check && astro build && node scripts/prepare-dist.mjs",
    "preview": "wrangler dev --config wrangler.jsonc --local",
    "typecheck": "astro check",
    "lint": "eslint 'src/**/*.ts' tests",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "latest",
    "astro": "latest",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
