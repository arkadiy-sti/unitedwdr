---
import manifest from "@/data/heroAssets.json";
type ObjectId = keyof typeof manifest.assets;
interface Props { id: ObjectId }
const { id } = Astro.props;
const asset: any = manifest.assets[id];
const x = asset.registered[0] ?? .5;
const y = asset.registered[1] ?? .5;
const flipped = "flip" in asset && asset.flip;
const isStandalone = "file" in asset;
const [naturalWidth, naturalHeight] = isStandalone ? asset.naturalSize : [asset.crop[2] ?? 1, asset.crop[3] ?? 1];
const width = asset.height * 941 * naturalWidth / naturalHeight / 1672;
const style = `left:${(x * 100).toFixed(3)}%;top:${(y * 100).toFixed(3)}%;width:${(width * 100).toFixed(3)}%;height:${(asset.height * 100).toFixed(3)}%`;
const maskId = `uwd-mask-${id}`;
const source = isStandalone ? `/uwd-hero/assets/${asset.file}` : `/uwd-hero/assets/source-${String(asset.source).padStart(2, "0")}.webp`;
---
{isStandalone ? (
  <img class:list={["uwd-object", { "uwd-object-flipped": flipped }]} data-object={id} data-asset={asset.asset} style={style} data-uwd-source={source} alt="" aria-hidden="true" decoding="async" />
) : (
  <svg class:list={["uwd-object", { "uwd-object-flipped": flipped }]} data-object={id} data-asset={asset.asset} style={style} viewBox={`${asset.crop[0] ?? 0} ${asset.crop[1] ?? 0} ${naturalWidth} ${naturalHeight}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
    <defs><clipPath id={maskId} clipPathUnits="userSpaceOnUse"><path d={asset.path} fill-rule="evenodd" /></clipPath></defs>
    <image data-uwd-source={source} x="0" y="0" width="1672" height="941" clip-path={`url(#${maskId})`} />
  </svg>
)}
