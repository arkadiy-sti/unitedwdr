---
import PhotoObject from "./PhotoObject.astro";
import { businessConfig as b } from "@/config/businessConfig";
import { heroStages } from "@/lib/heroTimeline";
import "@/styles/uwd-hero.css";
---
<section class="uwd-hero-story" id="restoration-story" data-uwd-story aria-labelledby="uwd-title">
  <div class="uwd-sticky">
    <div class="uwd-world" data-uwd-world aria-hidden="true">
      <img class="uwd-base" src="/uwd-hero/assets/base-house.webp" width="1672" height="941" alt="" fetchpriority="high" decoding="async" />
      <div class="uwd-storm" data-uwd-storm></div>
      <div class="uwd-wetness" data-uwd-wet></div>
      <div class="uwd-moisture" data-uwd-moisture></div>
      <svg class="uwd-damage-zones" data-uwd-damage viewBox="0 0 1920 1080" preserveAspectRatio="none" focusable="false">
        <defs>
          <linearGradient id="uwd-material-wet" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4c8da5" stop-opacity=".48"/><stop offset="1" stop-color="#174c67" stop-opacity=".14"/></linearGradient>
          <radialGradient id="uwd-ceiling-wet"><stop offset="0" stop-color="#28718d" stop-opacity=".38"/><stop offset="1" stop-color="#28718d" stop-opacity="0"/></radialGradient>
        </defs>
        <path d="M1010 472 Q1138 470 1355 473 L1355 490 Q1175 485 1010 490Z" />
        <path d="M1398 471 Q1550 468 1711 473 L1711 491 Q1535 485 1398 489Z" />
        <path d="M916 772 Q1080 769 1245 772 L1245 791 Q1063 784 916 791Z" />
        <ellipse cx="1117" cy="490" rx="134" ry="26" />
        <ellipse cx="1515" cy="491" rx="150" ry="26" />
      </svg>
      <div class="uwd-recovery" data-uwd-recovery></div>
      <svg class="uwd-water-pools" data-uwd-pools viewBox="0 0 1920 1080" preserveAspectRatio="none" focusable="false">
        <defs><linearGradient id="uwd-pool-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a6cdd9" stop-opacity=".04"/><stop offset="1" stop-color="#39789b" stop-opacity=".32"/></linearGradient></defs>
        <path d="M 1070 463 Q 1140 457 1200 461 L 1235 469 Q 1160 474 1080 470 Z" />
        <path d="M 1450 463 Q 1510 457 1570 461 L 1610 470 Q 1530 475 1460 470 Z" />
        <path d="M 920 776 Q 1000 769 1080 775 L 1105 783 Q 1020 787 930 782 Z" />
        <path d="M 1430 777 Q 1520 770 1600 775 L 1630 783 Q 1530 788 1440 782 Z" />
      </svg>
      <canvas class="uwd-weather-canvas" data-uwd-weather width="1672" height="941"></canvas>
      <PhotoObject id="van" />
      <svg class="uwd-extraction-hose" data-uwd-hose viewBox="0 0 1920 1080" preserveAspectRatio="none" focusable="false">
        <path d="M 555 866 C 642 870, 684 914, 776 873 S 900 822, 964 803 C 1013 791, 1070 804, 1147 770" pathLength="1" />
      </svg>
      <PhotoObject id="techLower" />
      <PhotoObject id="techUpper" />
      <PhotoObject id="extractor" />
      <PhotoObject id="am1" />
      <PhotoObject id="am2" />
      <PhotoObject id="am3" />
      <PhotoObject id="am4" />
      <PhotoObject id="dehu" />
      <svg class="uwd-airflow" data-uwd-airflow viewBox="0 0 1920 1080" preserveAspectRatio="none" focusable="false">
        <defs>
          <clipPath id="uwd-living-clip"><rect x="900" y="520" width="465" height="278" /></clipPath>
          <clipPath id="uwd-kitchen-clip"><rect x="1365" y="520" width="372" height="283" /></clipPath>
          <clipPath id="uwd-bath-clip"><rect x="985" y="200" width="400" height="280" /></clipPath>
          <clipPath id="uwd-laundry-clip"><rect x="1390" y="200" width="350" height="280" /></clipPath>
        </defs>
        <g clip-path="url(#uwd-living-clip)"><path d="M1031 753 C1067 749 1104 745 1140 747" /><path d="M1031 758 C1070 764 1099 758 1130 756" /></g>
        <g clip-path="url(#uwd-kitchen-clip)"><path d="M1620 773 C1585 757 1537 759 1495 765" /><path d="M1619 778 C1582 775 1549 783 1513 779" /></g>
        <g clip-path="url(#uwd-bath-clip)"><path d="M1195 460 C1231 450 1270 451 1304 454" /><path d="M1195 465 C1228 468 1260 465 1294 463" /></g>
        <g clip-path="url(#uwd-laundry-clip)"><path d="M1560 461 C1527 451 1490 453 1454 459" /><path d="M1560 466 C1529 468 1495 469 1469 466" /></g>
      </svg>
      <div class="uwd-monitor" data-uwd-monitor><span>Moisture mapping at the affected wall, floor, and overhead materials</span><i data-label="WALL"></i><i data-label="OVERHEAD"></i><i data-label="FLOOR"></i></div>
    </div>

    <div class="uwd-edge-shade" aria-hidden="true"></div>
    <div class="uwd-intro-panel">
      <img src="/uwd-hero/assets/united-logo.webp" width="608" height="498" alt="" class="uwd-panel-logo" decoding="async" />
      <p class="uwd-kicker">{b.serviceLabel()} · San Jose & Bay Area</p>
      <h1 id="uwd-title">Water damage?<br /><em>We're here 24/7.</em></h1>
      <p class="uwd-intro-copy">Fast response. Professional restoration. A drier, safer home.</p>
      <nav class="uwd-service-links" aria-label="Key services"><a href="/water-damage-restoration/">Water damage restoration</a><a href="/flood-cleanup/">Flood cleanup</a><a href="/structural-drying/">Structural drying</a><a href="/sewage-cleanup/">Sewage cleanup</a></nav>
      <a class="uwd-call" href={`tel:${b.phoneHref}`} data-event="phone_click"><span>Call now</span><strong>{b.phoneDisplay}</strong></a>
      <a class="uwd-request" href="#request" data-event="request_service_open">Request service <span aria-hidden="true">↗</span></a>
      <p class="uwd-proof">Santa Clara based <span>·</span> Local response <span>·</span> Documented drying</p>
    </div>

    <div class="uwd-story-caption">
      <p data-uwd-stage-label>{heroStages[0].label}</p>
      <h2 data-uwd-stage-title>{heroStages[0].title}</h2>
      <span data-uwd-stage-copy>{heroStages[0].copy}</span>
      <a class="uwd-stage-cta" href={`tel:${b.phoneHref}`} data-event="phone_click">Call UNITED <span aria-hidden="true">↗</span></a>
    </div>
    <div class="uwd-mobile-detail" data-uwd-mobile-detail>
      <p>What this means for your home</p>
      <span data-uwd-stage-detail>{heroStages[0].detail}</span>
      <a href={`tel:${b.phoneHref}`} data-event="phone_click">Call UNITED <strong>{b.phoneDisplay}</strong></a>
    </div>
    <p class="uwd-visual-note">Conceptual restoration visualization</p>
    <div class="uwd-progress" aria-hidden="true"><span data-uwd-progress></span><small data-uwd-count>01 / 11</small></div>
    <a class="uwd-scroll-hint" href="#services">Explore our services <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></a>
    <div class="uwd-story-controls" aria-label="Restoration animation controls">
      <button type="button" data-uwd-previous aria-label="Previous restoration stage"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></button>
      <span>Scroll to restore</span>
      <button type="button" data-uwd-next aria-label="Next restoration stage"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg></button>
    </div>
    <div class="uwd-exit" data-uwd-exit aria-hidden="true"></div>
  </div>
  <div class="uwd-accessible-story">
    <h2>How a water-damaged home is restored</h2>
    <ol>{heroStages.map((stage) => <li><strong>{stage.title}.</strong> {stage.copy} {stage.detail}</li>)}</ol>
  </div>
</section>
<script src="./heroController.ts"></script>
