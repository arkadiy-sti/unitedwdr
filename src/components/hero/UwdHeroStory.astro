---
import { businessConfig as b } from "@/config/businessConfig";
import { heroStages } from "@/lib/heroTimeline";
import "@/styles/uwd-hero.css";
---
<section class="uwd-hero-story" data-uh-scroll id="restoration-story">
  <link rel="preload" as="image" href="/uwd-hero/uh/assets/base-storm.webp" fetchpriority="high" />
  <link rel="stylesheet" href="/uwd-hero/uh/united-hero.css" />
  <div data-united-hero data-assets="/uwd-hero/uh/assets/" data-mode="scroll" data-uwd-hero>
    <div class="uwd-intro-panel">
      <p class="uwd-kicker">{b.serviceLabel()} · San Jose & Bay Area</p>
      <h1 id="uwd-title">Water damage?<br /><em>We're here 24/7.</em></h1>
      <p class="uwd-intro-copy">Fast response. Professional restoration. A drier, safer home.</p>
      <nav class="uwd-service-links" aria-label="Key services"><a href="/water-damage-restoration/">Water damage restoration</a><a href="/flood-cleanup/">Flood cleanup</a><a href="/structural-drying/">Structural drying</a><a href="/sewage-cleanup/">Sewage cleanup</a></nav>
      <a class="uwd-call" href={`tel:${b.phoneHref}`} data-event="phone_click"><span>Call now</span><strong>{b.phoneDisplay}</strong></a>
      <a class="uwd-request" href="#request" data-event="request_service_open">Request service <span aria-hidden="true">↗</span></a>
      <p class="uwd-proof">Santa Clara based <span>·</span> Local response <span>·</span> Documented drying</p>
    </div>
    <div class="uwd-story-caption" data-uwd-caption>
      <p data-uwd-stage-label>{heroStages[0].label}</p>
      <h2 data-uwd-stage-title>{heroStages[0].title}</h2>
      <span data-uwd-stage-detail>{heroStages[0].detail}</span>
      <a class="uwd-stage-cta" href={`tel:${b.phoneHref}`} data-event="phone_click">Call UNITED <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <script is:inline src="/uwd-hero/uh/united-hero.js" defer></script>
  <div class="uwd-accessible-story">
    <h2>How a water-damaged home is restored</h2>
    <ol>{heroStages.map((stage) => <li><strong>{stage.title}.</strong> {stage.copy} {stage.detail}</li>)}</ol>
  </div>
</section>

<script>
  import { heroStages } from "@/lib/heroTimeline";
  const story = document.querySelector<HTMLElement>("[data-uh-scroll]");
  const host = story?.querySelector<HTMLElement>("[data-uwd-hero]");
  const label = story?.querySelector<HTMLElement>("[data-uwd-stage-label]");
  const title = story?.querySelector<HTMLElement>("[data-uwd-stage-title]");
  const detail = story?.querySelector<HTMLElement>("[data-uwd-stage-detail]");
  host?.addEventListener("uh:scene", (event) => {
    const index = (event as CustomEvent<{ index: number }>).detail.index - 1;
    const stage = heroStages[index];
    if (!stage) return;
    if (label) label.textContent = stage.label;
    if (title) title.textContent = stage.title;
    if (detail) detail.textContent = stage.detail;
  });

  // The site's sitewide sticky "Call now" bar (mobile only) sits at a higher
  // z-index than anything in the hero, so for the whole time this section is
  // on screen it was permanently covering the engine's own bottom timeline
  // and stage caption on phones. Hide that bar only while the hero is in
  // view, then let it come back for the rest of the page.
  if (story && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(([entry]) => {
      document.body.classList.toggle("uwd-hero-in-view", entry?.isIntersecting ?? false);
    });
    observer.observe(story);
  }
</script>
