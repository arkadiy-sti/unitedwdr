---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/home-enhancements.css";
import "@/styles/site-refinement.css";
import PageMotion from "@/components/layout/PageMotion.astro";
import UwdHeroStory from "@/components/hero/UwdHeroStory.astro";
import LeadForm from "@/components/forms/LeadForm.astro";
import ProjectGallery from "@/components/projects/ProjectGallery.astro";
import { businessConfig as b } from "@/config/businessConfig";
import { services } from "@/data/services";
import { allServiceAreas, priorityLocations } from "@/data/locations";
import { faqs } from "@/data/faqs";
export const prerender=true;
const faqSchema={"@context":"https://schema.org","@type":"FAQPage",mainEntity:faqs.map(item=>({"@type":"Question",name:item.q,acceptedAnswer:{"@type":"Answer",text:item.a}}))};
---
<BaseLayout title="Water Damage Restoration San Jose & Santa Clara | UNITED" description="Professional water damage restoration, extraction, moisture mapping, and structural drying in San Jose, Santa Clara, and the Bay Area. Call UNITED." schema={faqSchema}>
  <UwdHeroStory />
  <section class="section services-editorial" id="services"><div class="shell"><header class="section-head"><p class="eyebrow">What we handle</p><h2>Water damage.<br />Handled with care.</h2><p>From the first sign of water to verified drying, one team helps you move forward.</p></header>
    <div class="service-list">{services.map((service,index)=><a class="service-row" href={`/${service.slug}/`}><span>{String(index+1).padStart(2,"0")}</span><div><h3>{service.name}</h3><p>{service.summary}</p></div><svg class="service-arrow" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>)}</div>
  </div></section>
  <section class="section split-section" id="process"><div class="shell split"><div class="sticky-copy"><p class="eyebrow">Professional drying matters</p><h2>Dry isn’t a look.<br />It’s a measured condition.</h2><p>Water can pass beneath flooring, wick into drywall, and settle in cavities. A professional drying plan manages both the affected materials and the surrounding air.</p><div class="section-actions"><a class="button primary" href={`tel:${b.phoneHref}`}>Call now</a><a class="text-link" href="/structural-drying/">Explore structural drying →</a></div></div>
    <ol class="process-list"><li><span>01</span><h3>Inspect</h3><p>Identify the source, water path, and affected materials.</p></li><li><span>02</span><h3>Find the moisture</h3><p>Map visible and hidden areas before setting the scope.</p></li><li><span>03</span><h3>Extract</h3><p>Remove accessible standing water efficiently.</p></li><li><span>04</span><h3>Set equipment</h3><p>Position air movement and dehumidification for the assembly.</p></li><li><span>05</span><h3>Monitor</h3><p>Track material and environmental conditions as they change.</p></li><li><span>06</span><h3>Verify and document</h3><p>Use readings to support the drying conclusion and next steps.</p></li></ol>
  </div></section>
  <section class="section equipment-section"><div class="shell"><div class="equipment-heading"><div><p class="eyebrow light">The science of drying</p><h2>A complete drying system.<br />A coordinated response.</h2></div></div><div class="equipment-grid"><article><span>01</span><h3>Extraction</h3><p>Removes accessible water faster than evaporation alone.</p></article><article><span>02</span><h3>Air movement</h3><p>Supports controlled evaporation at wet surfaces.</p></article><article><span>03</span><h3>Dehumidification</h3><p>Captures moisture released into the air.</p></article><article><span>04</span><h3>Moisture meters</h3><p>Help locate affected materials and document change.</p></article><article><span>05</span><h3>HEPA filtration</h3><p>Can support appropriate containment and air-control plans.</p></article></div></div></section>
  <ProjectGallery />
  <section class="section why-section"><div class="shell why-grid"><div><p class="eyebrow">Why UNITED</p><h2>Calm communication. Visible process. Documented progress.</h2></div><div class="why-points"><p><strong>Local focus</strong>Based in Santa Clara, with San Jose and the surrounding Bay Area at the center of the service footprint.</p><p><strong>Measured decisions</strong>Inspection and moisture information shape the response instead of assumptions.</p><p><strong>Clear next steps</strong>You should understand what is affected, what is being done, and what comes next.</p></div></div></section>
  <section class="section area-section"><div class="shell area-grid"><div><p class="eyebrow">Service area</p><h2>Based in Santa Clara.<br />Focused on the Bay Area.</h2><p>San Jose and Santa Clara are the primary service area, with coverage extending across many nearby Bay Area communities.</p><div class="priority-links">{priorityLocations.map(location=><a href={`/service-area/${location.slug}/`}>{location.name} <span>→</span></a>)}</div></div><div class="area-cloud" aria-label="Additional Bay Area communities served">{allServiceAreas.map(area=><span>{area}</span>)}</div></div></section>
  <section class="section faq-section"><div class="shell narrow"><p class="eyebrow">Questions, answered plainly</p><h2>Water damage FAQ</h2>{faqs.map((item,index)=><details open={index===0}><summary>{item.q}<span>+</span></summary><p>{item.a}</p></details>)}</div></section>
  <section class="section request-section" id="request"><div class="shell request-grid"><div><p class="eyebrow light">Request service</p><h2>Tell us what happened.</h2><p>Keep it short. We need enough information to understand the water source, location, and timing.</p><a class="call-panel" href={`tel:${b.phoneHref}`}><span>Prefer to call?</span><strong>{b.phoneDisplay}</strong></a></div><LeadForm /></div></section>
  <div class="mobile-call"><a href={`tel:${b.phoneHref}`} data-event="phone_click"><span>Call now</span><strong>{b.phoneDisplay}</strong></a></div>
  <PageMotion />
</BaseLayout>
